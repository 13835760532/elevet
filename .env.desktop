# 桌面安装包：前端静态文件通过 Electron app:// 协议加载。
NODE_ENV=production
VITE_DEV=false
VITE_APP_DESKTOP=true

# /admin-api 由 Electron 主进程代理到生产服务，避免 file:// 直连的跨域问题。
VITE_BASE_URL=
VITE_API_URL=/admin-api

VITE_UPLOAD_TYPE=server
VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true
VITE_SOURCEMAP=false
VITE_BASE_PATH=/
VITE_OUT_DIR=dist-desktop

# 桌面端登录页不依赖本地开发环境预填账号或验证码。
VITE_APP_CAPTCHA_ENABLE=false
VITE_APP_TENANT_ENABLE=false
